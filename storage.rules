rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper functions ─────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'vinaybhadane06@gmail.com' ||
         request.auth.token.email == 'bhadane123vinay@gmail.com');
    }

    function isValidImage() {
      return (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'image/webp')
        && request.resource.size <= 10 * 1024 * 1024; // 10MB max (client compresses to <1MB)
    }

    // ─── Post images (admin only can upload) ──────────────────────────────────
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ─── User avatars (any auth user) ─────────────────────────────────────────
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidImage();
    }

    // Block everything else
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
