rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
  function validPost() {
   let d = request.resource.data;
   return d.title is string && d.title.size() > 0 && d.title.size() <= 500
    && d.content is string && d.content.size() <= 900000
    && d.slug is string && d.slug.size() <= 500
    && d.status in ['draft', 'published'] && d.tags is list && d.tags.size() <= 100
    && d.views is number && d.views >= 0;
  }
  match /posts/{id} {
   allow read: if resource.data.status == 'published' || isAdmin();
   allow create, update: if isAdmin() && validPost();
   allow delete: if isAdmin();
  }
  match /comments/{id} {
   // Public projection and bounded creation go through the verified server API.
   allow read: if isAdmin();
   allow create, update: if false;
   allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
  }
  match /contacts/{id} {
   allow create: if false;
   allow read, delete: if isAdmin();
   allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
  }
  match /units/{id} {
   allow read: if true;
   allow create, update: if isAdmin() && (
    (request.resource.data.get('type','') == 'notification' && request.resource.data.title is string && request.resource.data.content is string && request.resource.data.content.size() <= 10000)
    || (request.resource.data.name is string && request.resource.data.name.size() <= 500 && request.resource.data.subjectSlug is string && request.resource.data.order is number && request.resource.data.order >= 0));
   allow delete: if isAdmin();
  }
  match /browseConfig/{id} {
   allow read: if true;
   allow create, update: if isAdmin() && request.resource.data.bgImageUrl is string && request.resource.data.bgImageUrl.size() <= 2048;
   allow delete: if isAdmin();
  }
  match /notifications/{id} {
   allow read: if true;
   allow create, update: if isAdmin() && request.resource.data.title is string && request.resource.data.content is string;
   allow delete: if isAdmin();
  }
  match /subjects/{id} {
   allow read: if true;
   allow create, update: if isAdmin() && request.resource.data.name is string && request.resource.data.name.size() <= 500
    && request.resource.data.slug is string && request.resource.data.year in ['1st','2nd','3rd','4th'];
   allow delete: if isAdmin();
  }
  match /subjectNotes/{id} {
   allow read: if true;
   allow create, update: if isAdmin() && request.resource.data.subjectSlug == id && request.resource.data.units is list && request.resource.data.units.size() <= 100;
   allow delete: if isAdmin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
